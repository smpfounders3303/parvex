# ─────────────────────────────────────────────────────────────────────────────
# PARVEX — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# SECRETS — Never commit these
.env
.env.local
.env.*.local

# Next.js build output
.next/
out/

# Node dependencies
node_modules/

# Prisma generated client (regenerate with `npm run db:generate`)
prisma/generated/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
