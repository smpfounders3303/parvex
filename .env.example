# ─────────────────────────────────────────────────────────────────────────
# PARVEX — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────

# DATABASE ------------------------------------------------------------------
# PostgreSQL connection string. Any managed Postgres works (Neon, Supabase,
# Railway, RDS, etc). After setting this, run:
#   npm install
#   npx prisma generate
#   npx prisma migrate deploy   (or `npx prisma db push` for a fresh DB)
#   npm run db:seed
DATABASE_URL="postgresql://user:password@host:5432/parvex?schema=public"

# AUTH (Better Auth) ----------------------------------------------------------
# Generate a strong secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# The deployed base URL of this app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
# Used client-side by the Better Auth client — should match BETTER_AUTH_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# INITIAL SUPER_ADMIN ---------------------------------------------------------
# Only used once, by `npm run db:seed`, to create the first Admin account.
# After the first login, create additional users from /admin/users instead.
PARVEX_INITIAL_ADMIN_EMAIL="you@parvex.in"
PARVEX_INITIAL_ADMIN_PASSWORD="choose-a-strong-password-12-chars-min"
PARVEX_INITIAL_ADMIN_NAME="Parvex Admin"

# MEDIA (Cloudinary) ----------------------------------------------------------
# All uploaded media (projects, services, contact attachments) is stored
# here — never in Git or local disk. Free tier is enough to start.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# EMAIL (Resend) --------------------------------------------------------------
# Used to notify the team when the public Contact form is submitted.
# The enquiry is always saved to the database even if this is unset —
# it will simply be visible only in /admin/messages until configured.
RESEND_API_KEY=""
# Fallback recipient if Settings > Contact Form Recipient is empty in /admin.
CONTACT_FALLBACK_EMAIL="hello@parvex.in"
